# ==========================================
# Configuration File for Flask Backend
# ==========================================
# This file can be used for environment-specific settings

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Model Configuration
MODEL_PATH=backend/trained-model/weights/best.pt
MODEL_DEVICE=cpu
# For GPU, change to: MODEL_DEVICE=cuda

# Upload Configuration
UPLOAD_FOLDER=backend/uploads
MAX_FILE_SIZE=16777216  # 16 MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,bmp,webp

# CORS Configuration
FRONTEND_URL_1=http://localhost:5173
FRONTEND_URL_2=http://localhost:3000
FRONTEND_URL_PROD=https://your-frontend-domain.com

# Detection Configuration
DEFAULT_CONFIDENCE_THRESHOLD=0.5
MIN_CONFIDENCE_THRESHOLD=0.0
MAX_CONFIDENCE_THRESHOLD=1.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Performance
INFERENCE_TIMEOUT=300  # seconds
CLEANUP_INTERVAL=3600  # seconds

# Features
ENABLE_BATCH_PROCESSING=False
ENABLE_WEBCAM=True
ENABLE_DOWNLOAD=True
ENABLE_STATS=True
